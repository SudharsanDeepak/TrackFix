{
  "name": "railtrack-ai-backend",
  "version": "1.0.0",
  "description": "National-scale Railway Track Fitting Lifecycle & Predictive Monitoring System",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "test:load": "node tests/load/loadTestOrchestrator.js",
    "test:load:light": "node tests/load/loadTestOrchestrator.js LIGHT_TEST",
    "test:load:medium": "node tests/load/loadTestOrchestrator.js MEDIUM_TEST",
    "test:load:heavy": "node tests/load/loadTestOrchestrator.js HEAVY_TEST",
    "test:load:extreme": "node tests/load/loadTestOrchestrator.js EXTREME_TEST",
    "test:write-load": "node tests/load/writeLoadSimulator.js",
    "test:read-load": "node tests/load/readLoadSimulator.js",
    "test:shard-analysis": "node tests/load/shardAnalyzer.js",
    "generate:test-data": "node tests/load/dataGenerator.js",
    "migrate:data": "node scripts/migrateExistingData.js"
  },
  "keywords": [
    "railway",
    "qr",
    "monitoring",
    "ai",
    "government"
  ],
  "author": "Ministry of Railways",
  "license": "PROPRIETARY",
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "google-auth-library": "^9.4.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "redis": "^4.6.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
