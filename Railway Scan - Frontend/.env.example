# ===========================================
# RailTrack-FIX Frontend - Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values

# -----------------
# REQUIRED VARIABLES
# -----------------

# Backend API base URL (REQUIRED)
# Development: http://localhost:5000/api/v1
# Production: https://your-api-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth Client ID (REQUIRED for Google login)
# Get this from: https://console.cloud.google.com/apis/credentials
# Leave as placeholder if not using Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# -----------------
# OPTIONAL VARIABLES
# -----------------

# Application Environment
# Options: development, staging, production
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# App Configuration
VITE_APP_NAME=RailTrack-FIX
VITE_APP_VERSION=1.0.0

# API Settings
VITE_API_TIMEOUT=10000
VITE_RETRY_ATTEMPTS=3
VITE_RETRY_DELAY=1000

# Cache Settings
VITE_CACHE_TTL=300000

# Session Settings
VITE_SESSION_TIMEOUT_WARNING=300000
VITE_TOKEN_REFRESH_INTERVAL=840000

# File Upload Settings
VITE_MAX_IMAGE_SIZE=5242880
VITE_MAX_IMAGES_PER_INSPECTION=10

# Pagination Settings
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Auto-save Settings
VITE_AUTO_SAVE_INTERVAL=30000
VITE_AUTO_SAVE_EXPIRY=86400000

# Development Settings
VITE_ENABLE_REACT_DEVTOOLS=true
VITE_ENABLE_HMR=true

# Production Settings
VITE_ENABLE_SOURCE_MAPS=false
VITE_ENABLE_BUNDLE_ANALYSIS=false

# Security
VITE_ENABLE_HTTPS=false
VITE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------
# EXTERNAL SERVICES (Optional - Uncomment if needed)
# -----------------

# Error Tracking
# VITE_SENTRY_DSN=your-sentry-dsn

# Analytics
# VITE_GA_ID=your-google-analytics-id
# VITE_LOGROCKET_ID=your-logrocket-id

# Maps
# VITE_MAP_API_KEY=your-map-api-key

# -----------------
# SETUP INSTRUCTIONS
# -----------------
# 1. Copy this file: cp .env.example .env
# 2. Update VITE_API_BASE_URL with your backend URL
# 3. Update VITE_GOOGLE_CLIENT_ID if using Google OAuth
# 4. Adjust optional settings as needed
# 5. Never commit .env to version control
